<!-- mail_activity_enhancements/views/mail_activity_views.xml -->
<odoo>
  <data>

    <!-- ===== Form View (Main) ===== -->
    <record id="view_mail_activity_form_inherit_dates" model="ir.ui.view">
      <field name="name">mail.activity.form.inherit.dates</field>
      <field name="model">mail.activity</field>
      <field name="inherit_id" ref="mail.mail_activity_view_form"/>
      <field name="arch" type="xml">
        <!-- نضيف الحقول قبل تاريخ الاستحقاق (أكثر موقع ثابت في Odoo 17) -->
        <xpath expr="//field[@name='date_deadline']" position="before">
          <field name="date_start" widget="datetime" options="{'datepicker': {'showTime': true}}"/>
          <field name="duration_days" readonly="1"/>
        </xpath>
      </field>
    </record>

    <!-- ===== Tree/List View ===== -->
    <record id="view_mail_activity_tree_inherit_dates" model="ir.ui.view">
      <field name="name">mail.activity.tree.inherit.dates</field>
      <field name="model">mail.activity</field>
      <field name="inherit_id" ref="mail.mail_activity_view_tree"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='activity_type_id']" position="after">
          <field name="date_start"/>
          <field name="duration_days"/>
        </xpath>
      </field>
    </record>

    <!-- ===== Popup (Quick Create / Edit) ===== -->
    <record id="view_mail_activity_form_popup_inherit" model="ir.ui.view">
      <field name="name">mail.activity.form.popup.inherit.dates</field>
      <field name="model">mail.activity</field>
      <field name="inherit_id" ref="mail.mail_activity_view_form_popup"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='date_deadline']" position="before">
          <field name="date_start" optional="show"/>
        </xpath>
      </field>
    </record>

    <!-- ===== Search Filter: Upcoming (Mine) ===== -->
    <record id="view_mail_activity_search_inherit_upcoming" model="ir.ui.view">
      <field name="name">mail.activity.search.inherit.upcoming</field>
      <field name="model">mail.activity</field>
      <field name="inherit_id" ref="mail.mail_activity_view_search"/>
      <field name="arch" type="xml">
        <xpath expr="//search" position="inside">
          <filter string="Upcoming (Mine)"
                  name="upcoming_mine"
                  domain="[('user_id', '=', uid), ('date_start', '>=', context_today())]"
                  help="Show activities assigned to me that start today or later"/>
        </xpath>
      </field>
    </record>

    <!-- ===== Action Definition (keep same order) ===== -->
    <record id="action_mail_activity" model="ir.actions.act_window">
      <field name="name">Activities</field>
      <field name="res_model">mail.activity</field>
      <field name="view_mode">kanban,tree,form</field>
      <field name="context">{'search_default_upcoming_mine': 0}</field>
    </record>

  </data>
</odoo>
