<!-- mail_activity_enhancements/data/mail_activity_templates.xml -->
<odoo>
  <data noupdate="1">
    <record id="mail_activity_start_template" model="mail.template">
      <field name="name">Activity Start Reminder</field>
      <field name="model_id" ref="mail.model_mail_activity"/>
      <field name="subject">Reminder: activity starting today</field>
      <field name="body_html"><![CDATA[
        <p>Dear ${object.user_id.name},</p>
        <p>The activity <strong>${object.summary}</strong> is scheduled to start today (${object.date_start}).</p>
        <p>Regards</p>
      ]]></field>
      <field name="email_from">${(user.email_formatted or user.email) if user else ''}</field>
    </record>
  </data>
</odoo>
